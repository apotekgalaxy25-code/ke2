  var mp=Math.pow,mw=mp(2,32),i,j,res='',words=[],abl=ascii.length*8;
  var hash=sha256.h=sha256.h||[],k=sha256.k=sha256.k||[],pc=k.length,ic={};
  for(var c=2;pc<64;c++)if(!ic[c]){for(i=0;i<313;i+=c)ic[i]=c;hash[pc]=(mp(c,.5)*mw)|0;k[pc++]=(mp(c,1/3)*mw)|0}
  hash=hash.slice(0,8);
  ascii+='\x80';while(ascii.length%64-56)ascii+='\x00';
  for(i=0;i<ascii.length;i++){j=ascii.charCodeAt(i);words[i>>2]|=j<<((3-i)%4)*8}
  words[words.length]=((abl/mw)|0);words[words.length]=abl;
  for(j=0;j<words.length;){var w=words.slice(j,j+=16),old=hash;hash=hash.slice(0,8);
    for(i=0;i<64;i++){var w15=w[i-15],w2=w[i-2],a=hash[0],e=hash[4];
      var t1=hash[7]+(rr(e,6)^rr(e,11)^rr(e,25))+((e&hash[5])^((~e)&hash[6]))+k[i]+(w[i]=(i<16)?w[i]:(w[i-16]+(rr(w15,7)^rr(w15,18)^(w15>>>3))+w[i-7]+(rr(w2,17)^rr(w2,19)^(w2>>>10)))|0);
      var t2=(rr(a,2)^rr(a,13)^rr(a,22))+((a&hash[1])^(a&hash[2])^(hash[1]&hash[2]));
      hash=[(t1+t2)|0].concat(hash);hash[4]=(hash[4]+t1)|0}
    for(i=0;i<8;i++)hash[i]=(hash[i]+old[i])|0}
  for(i=0;i<8;i++)for(j=3;j+1;j--){var b=(hash[i]>>(j*8))&255;res+=((b<16)?0:'')+b.toString(16)}
  return res}
const AL='ABCDEFGHJKLMNPQRSTUVWXYZ23456789',norm=s=>String(s).toUpperCase().replace(/[^A-Z0-9]/g,'');
const E0=Date.UTC(2026,0,1)/864e5,udays=()=>Math.floor(Date.now()/864e5)-E0,B5=n=>AL[n&31];
function tagOf(id,pl){const h=sha256(sha256(LIC_S+'|'+id+'|'+pl)+LIC_S);let r='';for(let i=0;i<6;i++)r+=AL[parseInt(h.substr(i*2,2),16)%32];return r}
function mkCode(id,plan,day,ser){const v=(plan<<18)|(day<<6)|ser,pl=B5(v>>15)+B5(v>>10)+B5(v>>5)+B5(v);return pl+tagOf(id,pl)}
const PL=[{n:'1 Bulan',rp:25000,d:30},{n:'1 Tahun',rp:250000,d:365}];
function parseCode(id,c){if(c.length!==10||[...c].some(x=>AL.indexOf(x)<0))return null;const pl=c.slice(0,4);if(tagOf(id,pl)!==c.slice(4))return null;let v=0;for(const x of pl)v=(v<<5)|AL.indexOf(x);return{pl,plan:(v>>18)&3,day:(v>>6)&4095}}
/* Lisensi: trial 7 hari, lalu langganan 1 bulan / 1 tahun dengan kode dari admin (terikat ID perangkat) */
const fid=s=>s.slice(0,4)+'-'+s.slice(4),lsum=o=>sha256(LIC_S+[o.id,o.t0,o.last,o.exp||0,(o.used||[]).join(',')].join('|')).slice(0,10);
function newId(){const a=new Uint8Array(8);(window.crypto||{getRandomValues:x=>x.forEach((_,i)=>x[i]=Math.random()*256)}).getRandomValues(a);return[...a].map(x=>AL[x%32]).join('')}
function lset(o){o.s=lsum(o);try{localStorage.setItem('kkl2',JSON.stringify(o))}catch(e){}}
function lload(){let o=null,r=null,bad=false;try{r=localStorage.getItem('kkl2')}catch(e){}
  if(r){try{o=JSON.parse(r)}catch(e){}if(!o||typeof o!=='object'||o.s!==lsum(o))bad=true}
  const ok=!!o&&typeof o.id==='string'&&/^[A-Z2-9]{8}$/.test(o.id);
  if(!r){o={id:newId(),t0:Date.now(),last:Date.now(),exp:0,used:[]};lset(o)}
  else if(bad||!ok){o={id:ok?o.id:newId(),t0:0,last:Date.now(),exp:0,used:[]};lset(o)}
  return o}
let LST={};
function lcheck(){const o=lload(),now=Date.now(),roll=now<o.last-216e5,sub=!roll&&o.exp>now,tl=Math.ceil((o.t0+TRIAL*864e5-now)/864e5),tr=!roll&&!sub&&tl>0;
  if(!roll&&now-o.last>6e4){o.last=now;lset(o)}
  LST={id:o.id,roll,sub,trial:tr,exp:o.exp,left:sub?Math.ceil((o.exp-now)/864e5):Math.max(0,tl),locked:!(sub||tr),was:o.exp>0};lui();return LST}
function lui(){const s=LST,fmt=x=>new Date(x).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'});
  $('#lock').hidden=!s.locked;document.body.classList.toggle('locked',s.locked);
