.plan{display:flex;justify-content:space-between;align-items:center;gap:10px;background:var(--bg);border:1.5px solid var(--bd);border-radius:16px;padding:12px 14px;margin-bottom:10px}.plan small{display:block;color:var(--mu);font-size:12px;margin-top:2px}.plan.best{border-color:var(--p)}.pr2{text-align:right;white-space:nowrap}.plan>div:first-child{flex:1;min-width:0}.pr2 b{display:block;font-size:16px;margin-bottom:6px}
.stat{line-height:1.5}.stat b{font-size:18px;display:block;margin-bottom:4px}ol.how{padding-left:18px;color:var(--mu);line-height:1.7;font-size:14px}
</style></head><body>
