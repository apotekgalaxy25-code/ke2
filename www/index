const ABS="<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Absensi Pegawai<\/title>\n<style>\n:root{--bg:#f4f7f6;--surface:#fff;--ink:#12302c;--muted:#5d7571;--line:#d6e0de;--brand:#0f766e;--brand-ink:#fff;\n--m:#15803d;--mbg:#dcfce7;--t:#b91c1c;--tbg:#fee2e2;--i:#b45309;--ibg:#fef3c7;--s:#1d4ed8;--sbg:#dbeafe;\nbox-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}\n@media(prefers-color-scheme:dark){:root:not([data-theme=\"light\"]){color-scheme:dark;--bg:#0d1b19;--surface:#142825;--ink:#e3f1ee;--muted:#8fb0aa;--line:#264541;--brand:#2dd4bf;--brand-ink:#05211e;\n--m:#4ade80;--mbg:#12391f;--t:#f87171;--tbg:#421616;--i:#fbbf24;--ibg:#412d0a;--s:#93c5fd;--sbg:#172c52}}\n:root[data-theme=\"dark\"]{color-scheme:dark;--bg:#0d1b19;--surface:#142825;--ink:#e3f1ee;--muted:#8fb0aa;--line:#264541;--brand:#2dd4bf;--brand-ink:#05211e;\n--m:#4ade80;--mbg:#12391f;--t:#f87171;--tbg:#421616;--i:#fbbf24;--ibg:#412d0a;--s:#93c5fd;--sbg:#172c52}\n*{box-sizing:border-box}\nhtml{scroll-padding-top:env(safe-area-inset-top,0px)}\nbody{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 \"Segoe UI\",system-ui,-apple-system,Roboto,sans-serif}\n.wrap{max-width:880px;margin:0 auto;padding:16px}\nh1{font-size:1.5rem;margin:4px 0 14px;letter-spacing:-.01em}\nh2{font-size:1.05rem;margin:0 0 10px}\n.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:16px}\n.bar{display:flex;align-items:center;gap:8px;margin-bottom:12px}\n.bar .ttl{flex:1;text-align:center;font-weight:700;font-size:1.1rem}\nbutton{font:inherit;color:inherit;cursor:pointer}\n.nav{border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:8px 14px;min-height:40px}\n.nav:hover{border-color:var(--brand)}\n:focus-visible{outline:3px solid var(--brand);outline-offset:2px}\n.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}\n.dow{text-align:center;font-size:.8rem;color:var(--muted);padding:4px 0}\n.dow:first-child{color:var(--t)}\n.day{aspect-ratio:1/1.05;border:1px solid var(--line);background:var(--bg);border-radius:10px;padding:4px;display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;text-align:left;min-width:0}\n.day:hover{border-color:var(--brand)}\n.day .n{font-weight:700;font-size:.95rem}\n.day.sun .n{color:var(--t)}\n.day.today{box-shadow:inset 0 0 0 2px var(--brand)}\n.day .c{font-size:.72rem;border-radius:6px;padding:1px 5px;font-weight:600}\n.day.ok{background:var(--mbg)}.day.ok .c{color:var(--m)}\n.day.part{background:var(--tbg)}.day.part .c{color:var(--t)}\n.day.some{background:var(--ibg)}.day.some .c{color:var(--i)}\n.day.empty{visibility:hidden}\n.legend{display:flex;flex-wrap:wrap;gap:12px;margin-top:12px;font-size:.82rem;color:var(--muted)}\n.legend i{display:inline-block;width:12px;height:12px;border-radius:4px;margin-right:5px;vertical-align:-1px;border:1px solid var(--line)}\n.add{display:flex;gap:8px}\ninput[type=text]{flex:1;min-width:0;font:inherit;padding:10px 12px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--ink)}\n.pri{background:var(--brand);color:var(--brand-ink);border:0;border-radius:10px;padding:10px 16px;font-weight:700}\n.tw{overflow-x:auto}\ntable{width:100%;border-collapse:collapse;font-size:.92rem}\nth,td{padding:8px 6px;text-align:center;border-bottom:1px solid var(--line)}\nth:first-child,td:first-child{text-align:left}\nth{color:var(--muted);font-weight:600}\ntd.m{color:var(--m);font-weight:700}td.t{color:var(--t);font-weight:700}td.i{color:var(--i);font-weight:700}td.s{color:var(--s);font-weight:700}\n.del{border:0;background:none;color:var(--muted);padding:4px 8px;border-radius:8px}\n.del.sure{background:var(--tbg);color:var(--t);font-weight:700}\n.hint{color:var(--muted);font-size:.9rem;margin:0}\n.ov{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:flex-end;justify-content:center;z-index:20}\n.ov.on{display:flex}\n.sheet{background:var(--surface);width:100%;max-width:560px;max-height:88vh;overflow:auto;border-radius:18px 18px 0 0;padding:16px 16px calc(16px + env(safe-area-inset-bottom,0px))}\n@media(min-width:600px){.ov{align-items:center}.sheet{border-radius:18px}}\n.sh{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:10px}\n.sh b{font-size:1.05rem}\n.row{padding:10px 0;border-top:1px solid var(--line)}\n.row .nm{font-weight:600;margin-bottom:6px}\n.seg{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}\n.seg button{border:1px solid var(--line);background:var(--bg);border-radius:10px;padding:9px 2px;font-size:.88rem;min-height:42px}\n.seg button.on.m{background:var(--m);color:var(--brand-ink);border-color:var(--m)}\n.seg button.on.t{background:var(--t);color:var(--brand-ink);border-color:var(--t)}\n.seg button.on.i{background:var(--i);color:var(--brand-ink);border-color:var(--i)}\n.seg button.on.s{background:var(--s);color:var(--brand-ink);border-color:var(--s)}\n.acts{display:flex;gap:8px;margin-bottom:6px}\n.acts button{flex:1;border:1px solid var(--line);background:var(--bg);border-radius:10px;padding:9px;font-size:.9rem}\n@media(max-width:480px){.wrap{padding:10px}.day{padding:3px}.day .c{font-size:.62rem;padding:0 3px}}\n.pr{border-top:1px solid var(--line);padding:12px 0}\n.ph{display:flex;justify-content:space-between;gap:8px;margin-bottom:8px}\n.ph span{color:var(--m);font-weight:700}\n.pf{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}\n.pf label{font-size:.78rem;color:var(--muted);display:block}\n.pf input{width:100%;margin-top:2px;font:inherit;padding:8px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--ink)}\n.pt{display:flex;justify-content:space-between;align-items:center;margin-top:10px;gap:8px}\n.tot{font-size:1.15rem}\n.gt{display:flex;justify-content:space-between;border-top:2px solid var(--line);padding-top:10px;margin-top:4px;font-weight:700}\n.slipimg{width:100%;border-radius:10px;border:1px solid var(--line);margin-bottom:10px;display:block}\n.acts .pri{background:var(--brand);color:var(--brand-ink);border:0;font-weight:700}\n.mode{display:flex;gap:6px;margin-bottom:8px}.mode button{flex:1;border:1px solid var(--line);background:var(--bg);border-radius:10px;padding:8px;font-size:.9rem}.mode button.on{background:var(--brand);color:var(--brand-ink);border-color:var(--brand);font-weight:700}.pf.b{grid-template-columns:repeat(2,1fr)}\n.day{position:relative}.day.pick{box-shadow:inset 0 0 0 3px var(--s)}.day.pick::after{content:\"✓\";position:absolute;top:1px;right:4px;font-weight:800;color:var(--s)}\n.nav.on{background:var(--brand);color:var(--brand-ink);border-color:var(--brand)}.mbar{margin-top:12px}\n.mq{display:flex;gap:6px;margin:10px 0 8px}.mq button{flex:1;border:1px solid var(--line);background:var(--bg);border-radius:10px;padding:8px 2px;font-size:.85rem}\n<\/style>\n<\/head>\n<body>\n<div class=\"wrap\">\n<h1>Absensi Pegawai<\/h1>\n\n<section class=\"card\">\n  <div class=\"bar\">\n    <button class=\"nav\" id=\"prev\" aria-label=\"Bulan sebelumnya\">‹<\/button>\n    <div class=\"ttl\" id=\"ttl\"><\/div>\n    <button class=\"nav\" id=\"next\" aria-label=\"Bulan berikutnya\">›<\/button>\n    <button class=\"nav\" id=\"today\">Hari ini<\/button>\n  <\/div>\n  <div class=\"grid\" id=\"dows\"><\/div>\n  <div class=\"grid\" id=\"cal\"><\/div>\n  <div class=\"legend\">\n    <span><i style=\"background:var(--mbg)\"><\/i>Semua masuk<\/span>\n    <span><i style=\"background:var(--tbg)\"><\/i>Ada yang tidak masuk<\/span>\n    <span><i style=\"background:var(--ibg)\"><\/i>Belum lengkap<\/span>\n  <\/div>\n  <div class=\"mbar\"><button class=\"nav\" id=\"mtog\" style=\"width:100%\"><\/button><\/div>\n  <div id=\"mact\" hidden>\n    <div class=\"mq\"><button id=\"mAll\">Semua tanggal<\/button><button id=\"mNoSun\">Tanpa Minggu<\/button><button id=\"mRst\">Reset pilihan<\/button><\/div>\n    <div class=\"acts\"><button class=\"pri\" id=\"mHadir\">✓ Hadir semua<\/button><button id=\"mSet\">Atur per pegawai<\/button><\/div>\n    <p class=\"hint\" id=\"mcnt\"><\/p>\n  <\/div>\n<\/section>\n\n<section class=\"card\">\n  <h2>Daftar pegawai<\/h2>\n  <div class=\"add\">\n    <input type=\"text\" id=\"nm\" placeholder=\"Nama pegawai\" maxlength=\"40\" aria-label=\"Nama pegawai\">\n    <button class=\"pri\" id=\"addBtn\">Tambah<\/button>\n  <\/div>\n<\/section>\n\n<section class=\"card\">\n  <h2>Rekap <span id=\"rm\"><\/span><\/h2>\n  <div class=\"tw\" id=\"rekap\"><\/div>\n<\/section>\n\n<section class=\"card\">\n  <h2>Gaji pegawai <span id=\"gm\"><\/span><\/h2>\n  <input type=\"text\" id=\"biz\" placeholder=\"Nama usaha (tampil di slip)\" maxlength=\"40\" aria-label=\"Nama usaha\" style=\"width:100%;margin-bottom:8px\">\n  <p class=\"hint\">Gaji pokok = jumlah hari masuk × gaji per hari. Tunjangan dan potongan diisi per bulan.<\/p>\n  <div id=\"pay\"><\/div>\n<\/section>\n<section class=\"card\">\n  <h2>Backup &amp; Excel<\/h2>\n  <p class=\"hint\" style=\"margin-bottom:10px\">Simpan data absensi ke file, atau pindahkan ke perangkat lain.<\/p>\n  <div class=\"acts\"><button class=\"pri\" id=\"bkJ\">⬇️ Backup (JSON)<\/button><button id=\"rsJ\">⬆️ Restore (JSON)<\/button><\/div>\n  <div class=\"acts\"><button class=\"pri\" id=\"exX\">📗 Export Excel<\/button><button id=\"imX\">⬆️ Import Excel<\/button><\/div>\n  <input type=\"file\" id=\"fJ\" accept=\".json,application/json\" hidden>\n  <input type=\"file\" id=\"fX\" accept=\".xls,.xml,application/vnd.ms-excel,text/xml\" hidden>\n  <p class=\"hint\" id=\"bmsg\"><\/p>\n<\/section>\n<\/div>\n\n<div class=\"ov\" id=\"ov\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"dt\">\n  <div class=\"sheet\">\n    <div class=\"sh\"><b id=\"dt\"><\/b><button class=\"nav\" id=\"close\">Tutup<\/button><\/div>\n    <div class=\"acts\"><button id=\"allM\">Semua masuk<\/button><button id=\"clr\">Kosongkan<\/button><\/div>\n    <div id=\"list\"><\/div>\n  <\/div>\n<\/div>\n\n<div class=\"ov\" id=\"ov2\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Slip gaji\">\n  <div class=\"sheet\">\n    <div class=\"sh\"><b>Slip gaji<\/b><button class=\"nav\" id=\"close2\">Tutup<\/button><\/div>\n    <img id=\"slipimg\" class=\"slipimg\" alt=\"Pratinjau slip gaji\">\n    <div class=\"acts\"><button class=\"pri\" id=\"shareBtn\">Kirim ke WhatsApp<\/button><button id=\"saveBtn\">Simpan JPEG<\/button><\/div>\n    <p class=\"hint\" id=\"note\"><\/p>\n  <\/div>\n<\/div>\n\n<script>\n(function(){\nvar KEY='absensi-pegawai-v1',S={emps:[],att:{}};\ntry{var r=localStorage.getItem(KEY);if(r){var p=JSON.parse(r);if(p&&p.emps&&p.att)S=p}}catch(e){}\nS.adj=S.adj||{};S.biz=S.biz||'';\nfunction save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}}\nvar $=function(i){return document.getElementById(i)};\nvar MON=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];\nvar DOW=['Min','Sen','Sel','Rab','Kam','Jum','Sab'];\nvar ST=[['m','Masuk'],['t','Tidak'],['i','Izin'],['s','Sakit']];\nvar now=new Date(),vy=now.getFullYear(),vm=now.getMonth(),sel=null,sels=null,multi=false,picks={},sure=null;\nfunction pad(n){return n<10?'0'+n:''+n}\nfunction key(y,m,d){return y+'-'+pad(m+1)+'-'+pad(d)}\nfunction esc(s){var d=document.createElement('div');d.textContent=s;return d.innerHTML}\n$('dows').innerHTML=DOW.map(function(d){return '<div class=\"dow\">'+d+'<\/div>'}).join('');\n\nfunction renderCal(){\n  $('ttl').textContent=MON[vm]+' '+vy;\n  $('rm').textContent='· '+MON[vm]+' '+vy;\n  var first=new Date(vy,vm,1).getDay(),days=new Date(vy,vm+1,0).getDate(),tk=key(now.getFullYear(),now.getMonth(),now.getDate()),h='';\n  for(var b=0;b<first;b++)h+='<div class=\"day empty\"><\/div>';\n  for(var d=1;d<=days;d++){\n    var k=key(vy,vm,d),rec=S.att[k]||{},tot=S.emps.length,cls='day',c='';\n    if((first+d-1)%7===0)cls+=' sun';\n    if(k===tk)cls+=' today';if(picks[k])cls+=' pick';\n    if(tot){\n      var rc=0,mc=0;\n      S.emps.forEach(function(e){if(rec[e.id]){rc++;if(rec[e.id]==='m')mc++}});\n      if(rc){c='<span class=\"c\">'+mc+'/'+tot+'<\/span>';\n        cls+=rc<tot?' some':(mc===tot?' ok':' part')}\n    }\n    h+='<button class=\"'+cls+'\" data-k=\"'+k+'\" data-d=\"'+d+'\"><span class=\"n\">'+d+'<\/span>'+c+'<\/button>';\n  }\n  $('cal').innerHTML=h;\n}\nfunction renderRekap(){\n  if(!S.emps.length){$('rekap').innerHTML='<p class=\"hint\">Belum ada pegawai. Tambahkan nama di atas, lalu klik tanggal di kalender untuk mencatat kehadiran.<\/p>';return}\n  var days=new Date(vy,vm+1,0).getDate(),h='<table><tr><th>Nama<\/th><th>Masuk<\/th><th>Tidak<\/th><th>Izin<\/th><th>Sakit<\/th><th><\/th><\/tr>';\n  S.emps.forEach(function(e){\n    var c={m:0,t:0,i:0,s:0};\n    for(var d=1;d<=days;d++){var r=S.att[key(vy,vm,d)];if(r&&r[e.id])c[r[e.id]]++}\n    h+='<tr><td>'+esc(e.name)+'<\/td><td class=\"m\">'+c.m+'<\/td><td class=\"t\">'+c.t+'<\/td><td class=\"i\">'+c.i+'<\/td><td class=\"s\">'+c.s+'<\/td><td><button class=\"del'+(sure===e.id?' sure':'')+'\" data-del=\"'+e.id+'\" aria-label=\"Hapus '+esc(e.name)+'\">'+(sure===e.id?'Yakin hapus?':'✕')+'<\/button><\/td><\/tr>';\n  });\n  $('rekap').innerHTML=h+'<\/table>';\n}\nfunction renderSheet(){\n  var h='';\n  if(sels){$('dt').textContent=sels.length+' tanggal dipilih'}else{var p=sel.split('-');$('dt').textContent=new Date(+p[0],+p[1]-1,+p[2]).toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}\n  if(!S.emps.length){$('list').innerHTML='<p class=\"hint\">Belum ada pegawai. Tutup jendela ini dan tambahkan nama pegawai dulu.<\/p>';return}\n  S.emps.forEach(function(e){\n    h+='<div class=\"row\"><div class=\"nm\">'+esc(e.name)+'<\/div><div class=\"seg\">';\n    ST.forEach(function(s){h+='<button class=\"'+s[0]+(stOf(e.id)===s[0]?' on':'')+'\" data-e=\"'+e.id