  $('#lmsg').textContent=s.roll?'Jam perangkat terdeteksi dimundurkan. Perbaiki jam perangkat, lalu buka kembali aplikasi.':s.was?'Langganan Anda telah berakhir. Perpanjang untuk melanjutkan, atau masukkan kode aktivasi dari admin.':'Masa percobaan '+TRIAL+' hari telah berakhir. Berlangganan untuk melanjutkan, atau masukkan kode aktivasi dari admin.';
  $('#lb').textContent=s.sub?'👑 Langganan: sisa '+s.left+' hari':s.trial?'⏳ Trial: sisa '+s.left+' hari':'🔒 Terkunci';
  $('#lsta').innerHTML=s.sub?`<div class="stat"><b>👑 Langganan aktif</b>Berlaku sampai ${fmt(s.exp)} (sisa ${s.left} hari). Perpanjang sebelum habis, sisa hari akan ditambahkan.</div>`:s.trial?`<div class="stat"><b>⏳ Masa percobaan</b>Sisa ${s.left} dari ${TRIAL} hari. Berlangganan agar aplikasi tidak terkunci.</div>`:`<div class="stat"><b>🔒 Aplikasi terkunci</b>${s.was?'Langganan berakhir.':'Masa percobaan habis.'} Pilih paket di bawah.</div>`}
function act(i,e){const c=norm($(i).value),er=m=>{$(e).textContent=m};if(c.length!==10)return er('Kode harus 10 karakter (huruf dan angka).');
  const o=lload(),r=parseCode(o.id,c);if(!r||r.plan>1)return er('Kode salah untuk perangkat ini.');
  if((o.used||[]).includes(r.pl))return er('Kode ini sudah pernah dipakai.');
  const df=udays()-r.day,now=Date.now();if(df>30||df<-1)return er('Kode kedaluwarsa (berlaku 30 hari sejak dibuat). Minta kode baru ke admin.');
  if(now<o.last-216e5)return er('Jam perangkat tidak sesuai. Perbaiki jam terlebih dahulu.');
  o.exp=Math.max(now,o.exp||0)+PL[r.plan].d*864e5;(o.used=o.used||[]).push(r.pl);o.last=Math.max(o.last,now);lset(o);
  $(i).value='';er('');lcheck();toast('Langganan '+PL[r.plan].n+' aktif ✅')}
